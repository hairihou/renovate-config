{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":timezone(Asia/Tokyo)",
    "group:definitelyTyped",
    "helpers:disableTypesNodeMajor",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "ignorePresets": [":dependencyDashboard", ":pinDevDependencies"],
  "draftPR": true,
  "lockFileMaintenance": {
    "schedule": ["before 4am on the first day of the month"]
  },
  "rangeStrategy": "bump",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update hk version in hk.pkl amends/import package URLs",
      "managerFilePatterns": ["/(^|/)hk\\.pkl$/"],
      "matchStrings": [
        "github\\.com/jdx/hk/releases/download/v(?<currentValue>\\d+\\.\\d+\\.\\d+)/hk@\\d+\\.\\d+\\.\\d+#"
      ],
      "depNameTemplate": "hk",
      "packageNameTemplate": "jdx/hk",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "autoReplaceStringTemplate": "github.com/jdx/hk/releases/download/v{{{newValue}}}/hk@{{{newValue}}}#"
    }
  ],
  "packageRules": [
    {
      "groupName": "linters",
      "extends": ["packages:linters"],
      "matchPackageNames": ["globals", "oxfmt"]
    },
    {
      "groupName": "hk",
      "matchDepNames": ["hk"]
    },
    {
      "matchManagers": ["mise"],
      "minimumReleaseAge": "1 day"
    },
    {
      "matchManagers": ["mise"],
      "matchDepNames": ["claude-code"],
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "uv bundles its Python download list; wait for a uv release that knows the new CPython",
      "matchDepNames": ["python"],
      "minimumReleaseAge": "3 days"
    }
  ]
}
